---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  ogType?: "website" | "article";
}

const SITE_NAME = "情報系の学生のための企業分析サイト";

const {
  title = SITE_NAME,
  description = "IT業界の企業を、給与・財務・事業構成の公表値で比較できる就活向けサイト",
  noindex = false,
  ogType = "website",
} = Astro.props;
const fullTitle = title === SITE_NAME ? title : `${title} | ${SITE_NAME}`;
// SNS のリンクプレビューは絶対 URL しか解決しないため、canonical と OGP 画像は
// astro.config.mjs の site を基準に絶対化する。
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/ogp.png", Astro.site);
const pathname = Astro.url.pathname;
const isHome = pathname === "/";
const isIndustry = pathname.startsWith("/industries/");
const isCompany = pathname.startsWith("/companies/");
const isGuide = pathname.startsWith("/guide/");
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f6f7f9" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icon.svg" />
    <title>{fullTitle}</title>

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={SITE_NAME} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script
      is:inline
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7392061896405683"
      crossorigin="anonymous"></script>
    <script is:inline>
      (() => {
        const systemTheme = window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light";

        try {
          const savedTheme = window.localStorage.getItem("theme");
          document.documentElement.dataset.theme =
            savedTheme === "light" || savedTheme === "dark"
              ? savedTheme
              : systemTheme;
        } catch {
          document.documentElement.dataset.theme = systemTheme;
        }
      })();
    </script>
  </head>
  <body>
    <div class="app-shell">
      <aside class="site-sidebar">
        <a class="brand" href="/">
          <img class="brand-icon" src="/icon.svg"  alt="情報系の学生のための企業分析サイト" />
        </a>
        <nav class="sidebar-nav" aria-label="メインナビゲーション">
          <a class:list={{ active: isHome }} href="/">ホーム</a>
          <a class:list={{ active: isIndustry }} href="/industries/">業界一覧</a>
          <a class:list={{ active: isCompany }} href="/companies/">企業一覧</a>
          <a class:list={{ active: isGuide }} href="/guide/">分析方法</a>
        </nav>

        <div class="sidebar-footer">
          <button class="theme-toggle" type="button" aria-label="ダークモードに切り替える" aria-pressed="false">
            <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20.2 15.2A8.4 8.4 0 0 1 8.8 3.8a8.4 8.4 0 1 0 11.4 11.4Z" />
            </svg>
            <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="3.5" />
              <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
            </svg>
            <span class="theme-toggle-label">ダークモード</span>
          </button>
          <p class="sidebar-meta">データ更新 2026年7月</p>
        </div>
      </aside>

      <div class="app-main">
        <main class="wrap">
          <slot />
        </main>
        <footer class="site-footer wrap">
          <p class="site-footer-meta">
            <span>運営者: 黒田 幸者</span>
            <a href="mailto:yukijya@big-a-k.com">yukijya@big-a-k.com</a>
            <a href="/privacy/">プライバシーポリシー・運営者情報</a>
          </p>
          <p class="site-footer-copyright">© 2026 @yukijya kuroda All Rights Reserved.</p>
        </footer>
      </div>
    </div>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const toggle = document.querySelector(".theme-toggle");
        const label = toggle?.querySelector(".theme-toggle-label");
        const themeColor = document.querySelector('meta[name="theme-color"]');
        const media = window.matchMedia("(prefers-color-scheme: dark)");

        const applyTheme = (theme) => {
          root.dataset.theme = theme;
          const isDark = theme === "dark";
          toggle?.setAttribute("aria-pressed", String(isDark));
          toggle?.setAttribute(
            "aria-label",
            isDark ? "ライトモードに切り替える" : "ダークモードに切り替える",
          );
          if (label) label.textContent = isDark ? "ライトモード" : "ダークモード";
          themeColor?.setAttribute("content", isDark ? "#0f1722" : "#f6f7f9");
        };

        applyTheme(root.dataset.theme === "dark" ? "dark" : "light");

        toggle?.addEventListener("click", () => {
          const theme = root.dataset.theme === "dark" ? "light" : "dark";
          applyTheme(theme);
          try {
            window.localStorage.setItem("theme", theme);
          } catch {
            // The selected theme still applies for this page when storage is unavailable.
          }
        });

        media.addEventListener("change", (event) => {
          try {
            if (window.localStorage.getItem("theme")) return;
          } catch {
            // Follow the system setting when storage is unavailable.
          }
          applyTheme(event.matches ? "dark" : "light");
        });
      })();
    </script>
  </body>
</html>
