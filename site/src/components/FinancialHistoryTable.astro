---
import { type Metric } from "../lib/data";
import { formatValue, metricLabels } from "../lib/format";

interface Props {
  metrics: Metric[];
  metricKeys: string[];
  maxYears?: number;
}

const { metrics, metricKeys, maxYears = 5 } = Astro.props;
const availableKeys = metricKeys.filter((key) =>
  metrics.some((metric) => metric.metric_key === key),
);
const years = [...new Set(
  metrics
    .filter((metric) => availableKeys.includes(metric.metric_key))
    .map((metric) => metric.fiscal_year),
)]
  .sort((a, b) => Number(b) - Number(a))
  .slice(0, maxYears);
---

{availableKeys.length > 0 && <div class="table-scroll financial-history">
  <table class="data-table">
    <thead>
      <tr><th>指標</th>{years.map((year) => <th>{year}年度</th>)}</tr>
    </thead>
    <tbody>
      {availableKeys.map((key) => <tr>
        <th>{metricLabels[key] ?? key}</th>
        {years.map((year) => {
          const row = metrics.find(
            (metric) => metric.metric_key === key && metric.fiscal_year === year,
          );
          return <td>{row ? formatValue(Number(row.value), row.unit, key) : "—"}</td>;
        })}
      </tr>)}
    </tbody>
  </table>
</div>}
