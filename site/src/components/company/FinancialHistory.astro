---
import FinancialHistoryTable from "../FinancialHistoryTable.astro";
import { annotationsForCompany } from "../../lib/data";
import {
  financialMetricKeys,
  financialMetricsForCompany,
} from "../../lib/company-financials";

interface Props {
  companyId: string;
}

const { companyId } = Astro.props;
const companyAnnotations = annotationsForCompany(companyId);
const financialMetrics = financialMetricsForCompany(companyId);
---

<section>
  <div class="section-head">
    <h2>資産状況・IR推移</h2>
    <p>売上、利益、キャッシュフローなどを表で確認できます。単位・対象範囲は指標ごとに異なります。</p>
  </div>
  <FinancialHistoryTable
    metrics={financialMetrics}
    metricKeys={financialMetricKeys}
    annotations={companyAnnotations}
  />
</section>
