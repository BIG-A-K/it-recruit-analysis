---
import { metrics, segments, sourceById } from "../../lib/data";

interface Props {
  companyId: string;
}

const { companyId } = Astro.props;
const companyMetrics = metrics.filter((metric) => metric.company_id === companyId);
const companySegments = segments.filter((segment) => segment.company_id === companyId);
const sourceIds = [
  ...new Set([
    ...companyMetrics.map((metric) => metric.source_id),
    ...companySegments.map((segment) => segment.source_id),
  ]),
].filter(Boolean);
const companySources = sourceIds
  .map(sourceById)
  .filter((source) => source !== undefined);
---

