---
import MetricExplorer from "../MetricExplorer.astro";
import { allCompanies } from "../../lib/data";
import { trendMetricsForCompany } from "../../lib/company-financials";

interface Props {
  companyId: string;
}

const { companyId } = Astro.props;
const company = allCompanies.find((item) => item.company_id === companyId);
if (!company) throw new Error(`企業が見つかりません: ${companyId}`);

const trendMetrics = trendMetricsForCompany(companyId);
---

{trendMetrics.length > 0 && <MetricExplorer
  companies={[company]}
  metrics={trendMetrics}
  explorerId={`company-explorer-${companyId}`}
  initialMetricKey="revenue"
/>}
