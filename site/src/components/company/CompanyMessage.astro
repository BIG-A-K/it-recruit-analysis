---
import { messageForCompany } from "../../lib/data";

interface Props {
  companyId: string;
}

const { companyId } = Astro.props;
const companyMessage = messageForCompany(companyId);
---

{companyMessage && <section class="company-message-section">
  <blockquote class="company-message">
    <span>{companyMessage.source_label}</span>
    <p>{companyMessage.message}</p>
  </blockquote>
</section>}
