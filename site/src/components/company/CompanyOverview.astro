---
import {
  allCompanies,
  companyRelations,
  industriesForCompany,
  metrics,
} from "../../lib/data";
import { formatValue, latestMetric } from "../../lib/format";

interface Props {
  companyId: string;
}

const { companyId } = Astro.props;
const company = allCompanies.find((item) => item.company_id === companyId);
if (!company) throw new Error(`企業が見つかりません: ${companyId}`);

// 複数業界にまたがる企業があるため、パンくずには先頭（主業界）だけを出し、分類欄にすべて並べる
const companyIndustryList = industriesForCompany(companyId);
const [primaryIndustry] = companyIndustryList;
const companyMetrics = metrics.filter(
  (metric) =>
    metric.company_id === companyId && metric.availability === "reported",
);
const totalFunding = latestMetric(companyMetrics, "total_funding");
// 単体の従業員数も持つため、概要では連結を明示して拾う
const employeeCount = latestMetric(
  companyMetrics,
  "employee_count",
  "consolidated",
);
const disclosureRelation = companyRelations.find(
  (item) =>
    item.from_company_id === companyId &&
    ["parent", "affiliate"].includes(item.relation_type) &&
    !item.valid_to,
);
const disclosureCompany = allCompanies.find(
  (item) => item.company_id === disclosureRelation?.to_company_id,
);
---

<section class="company-overview">
  <p class="breadcrumb">
    <a href="/">トップ</a><span>/</span>
    {primaryIndustry && <a href={`/industries/${primaryIndustry.industry_id}/`}>{primaryIndustry.name}</a>}
    <span>/</span>{company.display_name}
  </p>
  <div class="company-head">
    <div>
      <span class="eyebrow">企業研究</span>
      <h1>{company.display_name}</h1>
      <p>{company.legal_name}</p>
    </div>
    <a class="button button-outline" href={company.website_url} target="_blank" rel="noreferrer">
      公式サイト
    </a>
  </div>
  <dl class="facts facts-boxed basic-facts">
    <div><dt>分類</dt><dd class="industry-list">
      {companyIndustryList.length === 0 ? "—" : companyIndustryList.map((item, index) => (
        <Fragment>
          {index > 0 && <span class="industry-separator">/</span>}
          <a href={`/industries/${item.industry_id}/`}>{item.name}</a>
        </Fragment>
      ))}
    </dd></div>
    <div><dt>正式社名</dt><dd>{company.legal_name}</dd></div>
    {company.securities_code && <div><dt>証券コード</dt><dd>{company.securities_code}</dd></div>}
    {company.edinet_code && <div><dt>EDINETコード</dt><dd>{company.edinet_code}</dd></div>}
    {company.ticker && <div><dt>ティッカー</dt><dd>{company.exchange ? `${company.exchange}: ` : ""}{company.ticker}</dd></div>}
    {company.sec_cik && <div><dt>SEC CIK</dt><dd>{company.sec_cik}</dd></div>}
    {disclosureCompany && <div><dt>関連開示主体</dt><dd>{disclosureCompany.display_name}</dd></div>}
    {employeeCount && <div><dt>従業員数（連結・{employeeCount.fiscal_year}年度）</dt><dd>{formatValue(Number(employeeCount.value), employeeCount.unit, "employee_count")}</dd></div>}
    {totalFunding && <div><dt>累計資金調達額</dt><dd>{formatValue(Number(totalFunding.value), totalFunding.unit, "total_funding")}<small>非上場ベンチャーの公式発表値</small></dd></div>}
  </dl>
</section>
