---
import type { GetStaticPaths } from "astro";
import FinancialHistoryTable from "../../components/FinancialHistoryTable.astro";
import MetricExplorer from "../../components/MetricExplorer.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  annotationsForCompany,
  companies,
  companyIndustries,
  industries,
  messageForCompany,
  metrics,
  profileForCompany,
  segments,
  sourceById,
} from "../../lib/data";
import { formatValue, latestMetric } from "../../lib/format";

export const getStaticPaths = (() =>
  companies.map((company) => ({
    params: { companyId: company.company_id },
    props: { company },
  }))) satisfies GetStaticPaths;

const { company } = Astro.props;
const profile = profileForCompany(company.company_id);
const companyAnnotations = annotationsForCompany(company.company_id);
const companyMessage = messageForCompany(company.company_id);
const companyMetrics = metrics.filter(
  (metric) =>
    metric.company_id === company.company_id &&
    metric.availability === "reported",
);
const companySegments = segments.filter(
  (segment) =>
    segment.company_id === company.company_id &&
    segment.availability === "reported",
);
const latestSegmentYear = companySegments.length
  ? Math.max(...companySegments.map((segment) => Number(segment.fiscal_year)))
  : undefined;
const latestSegments = latestSegmentYear
  ? companySegments.filter(
      (segment) => Number(segment.fiscal_year) === latestSegmentYear,
    )
  : [];
const segmentTotal = latestSegments.reduce(
  (sum, item) => sum + Number(item.revenue || 0),
  0,
);

const relation = companyIndustries.find(
  (item) => item.company_id === company.company_id,
);
const industry = industries.find(
  (item) => item.industry_id === relation?.industry_id,
);

const salary = latestMetric(companyMetrics, "average_annual_salary");
const tenure = latestMetric(companyMetrics, "average_tenure");
const age = latestMetric(companyMetrics, "average_age");
const employmentYear = [salary, tenure, age]
  .filter((row) => row !== undefined)
  .reduce(
    (maximum, row) => Math.max(maximum, Number(row?.fiscal_year)),
    0,
  );

const healthKeys = ["current_assets", "current_liabilities", "quick_assets"];
const healthMetrics = companyMetrics.filter((metric) =>
  healthKeys.includes(metric.metric_key),
);
const currentAssets = latestMetric(healthMetrics, "current_assets");
const currentLiabilities = latestMetric(healthMetrics, "current_liabilities");
const quickAssets = latestMetric(healthMetrics, "quick_assets");
const healthYear = healthMetrics.length
  ? Math.max(...healthMetrics.map((metric) => Number(metric.fiscal_year)))
  : undefined;
const currentRatio = currentAssets && currentLiabilities
  ? (Number(currentAssets.value) / Number(currentLiabilities.value)) * 100
  : undefined;
const quickRatio = quickAssets && currentLiabilities
  ? (Number(quickAssets.value) / Number(currentLiabilities.value)) * 100
  : undefined;

const financialMetricKeys = [
  "revenue",
  "operating_profit",
  "net_cf",
  "operating_cf",
  "investing_cf",
  "financing_cf",
  "equity_ratio",
  "current_assets",
  "current_liabilities",
  "quick_assets",
];
const financialMetrics = companyMetrics.filter((metric) =>
  financialMetricKeys.includes(metric.metric_key),
);
const jobCategories = profile?.job_categories.split("|").filter(Boolean) ?? [];

const sourceIds = [
  ...new Set([
    ...companyMetrics.map((metric) => metric.source_id),
    ...companySegments.map((segment) => segment.source_id),
    ...companyAnnotations.map((annotation) => annotation.source_id),
  ]),
].filter(Boolean);
const companySources = sourceIds
  .map(sourceById)
  .filter((source) => source !== undefined);
---

<BaseLayout
  title={company.display_name}
  description={`${company.display_name}の基本情報、事業内容、新卒採用、財務・キャッシュフローを公表資料から確認できます。`}
>
  <section class="company-overview">
    <p class="breadcrumb">
      <a href="/">トップ</a><span>/</span>
      {industry && <a href={`/industries/${industry.industry_id}/`}>{industry.name}</a>}
      <span>/</span>{company.display_name}
    </p>
    <div class="company-head">
      <div>
        <span class="eyebrow">企業研究</span>
        <h1>{company.display_name}</h1>
        <p>{company.legal_name}</p>
      </div>
      <a class="button button-outline" href={company.website_url} target="_blank" rel="noreferrer">
        公式サイト
      </a>
    </div>

    {companyMessage && <blockquote class="company-message">
      <span>{companyMessage.source_label}</span>
      <p>{companyMessage.message}</p>
    </blockquote>}

    <dl class="facts facts-boxed basic-facts">
      <div><dt>分類</dt><dd>{industry?.name || "—"}</dd></div>
      <div><dt>正式社名</dt><dd>{company.legal_name}</dd></div>
      <div><dt>証券コード</dt><dd>{company.securities_code || "—"}</dd></div>
      <div><dt>EDINETコード</dt><dd>{company.edinet_code || "—"}</dd></div>
    </dl>
  </section>

  <section>
    <div class="section-head">
      <h2>IR・雇用情報</h2>
      <p>{employmentYear ? `${employmentYear}年度の提出会社単体の公表値を中心に掲載しています。` : "公表値を確認し、順次掲載します。"}</p>
    </div>
    <dl class="employment-grid">
      <div class="employment-tile featured"><dt>平均年間給与</dt><dd>{salary ? formatValue(Number(salary.value), salary.unit, salary.metric_key) : "—"}</dd><small>賞与・基準外賃金を含む場合があります</small></div>
      <div class="employment-tile"><dt>平均勤続年数</dt><dd>{tenure ? formatValue(Number(tenure.value), tenure.unit, tenure.metric_key) : "—"}</dd></div>
      <div class="employment-tile"><dt>平均年齢</dt><dd>{age ? formatValue(Number(age.value), age.unit, age.metric_key) : "—"}</dd></div>
      <div class="employment-tile"><dt>主な勤務地</dt><dd class="text-value">{profile?.workplace || "確認中"}</dd></div>
    </dl>
    <p class="section-note">平均値はグループ全体や職種別の給与・働き方を示すものではありません。</p>
  </section>

  <section>
    <div class="section-head">
      <h2>事業内容</h2>
      <p>{latestSegmentYear ? `${latestSegmentYear}年度の報告セグメントと売上構成です。` : "事業説明を準備しています。"}</p>
    </div>
    {profile?.overview && <p class="business-intro">{profile.overview}</p>}
    {latestSegments.length > 0 ? <div class="segment-cards">
      {latestSegments.map((segment, index) => {
        const share = segmentTotal
          ? (Number(segment.revenue) / segmentTotal) * 100
          : 0;
        return <article class="segment-card">
          <div class="segment-copy">
            <span class="segment-number">{String(index + 1).padStart(2, "0")}</span>
            <div>
              <h3>{segment.segment_name}</h3>
              <p>{segment.description || "公開資料上の報告区分です。詳しい事業説明は準備中です。"}</p>
            </div>
          </div>
          <div class="segment-visual">
            <div class="segment-value"><strong>{formatValue(Number(segment.revenue), segment.unit)}</strong><span>売上構成比 {share.toFixed(1)}%</span></div>
            <div class="segment-track" aria-label={`売上構成比 ${share.toFixed(1)}%`}><i style={`width:${share}%`}></i></div>
            {segment.segment_profit && <p>{segment.profit_measure}: {formatValue(Number(segment.segment_profit), segment.unit)}</p>}
          </div>
        </article>;
      })}
    </div> : <div class="empty-inline">セグメント別の説明と売上を準備しています。</div>}
  </section>

  <section>
    <div class="section-head">
      <h2>採用情報</h2>
      <p>新卒採用のみ掲載しています。募集年度により内容が変わるため公式情報も確認してください。</p>
    </div>
    {profile ? <div class="recruit-panel">
      <article>
        <span class="eyebrow">NEW GRADUATE</span>
        <h3>新卒募集要項</h3>
        <p>{profile.recruitment_summary}</p>
        <div class="job-chips" aria-label="主な募集職種">
          {jobCategories.map((job) => <span>{job}</span>)}
        </div>
      </article>
      <dl>
        <div><dt>勤務地</dt><dd>{profile.workplace}</dd></div>
        <div><dt>初任給・待遇</dt><dd>{profile.compensation}</dd></div>
      </dl>
      <div class="recruit-footer">
        <p>{profile.employment_note}</p>
        <a class="button button-primary" href={profile.career_url} target="_blank" rel="noreferrer">公式募集要項を見る</a>
      </div>
    </div> : <div class="empty-inline">新卒募集要項を確認中です。</div>}
  </section>

  <section>
    <div class="section-head">
      <h2>企業健全性指標</h2>
      <p>{healthYear ? `${healthYear}年度・連結の流動性に関する指標です。` : "流動資産・流動負債を取得できた企業から掲載します。"}</p>
    </div>
    {healthMetrics.length > 0 ? <dl class="health-grid">
      <div><dt>流動資産</dt><dd>{currentAssets ? formatValue(Number(currentAssets.value), currentAssets.unit) : "—"}</dd>{currentRatio !== undefined && <small>流動比率 {currentRatio.toFixed(1)}%</small>}</div>
      <div><dt>流動負債</dt><dd>{currentLiabilities ? formatValue(Number(currentLiabilities.value), currentLiabilities.unit) : "—"}</dd><small>1年以内に支払期限を迎える負債</small></div>
      <div><dt>当座資産</dt><dd>{quickAssets ? formatValue(Number(quickAssets.value), quickAssets.unit) : "—"}</dd>{quickRatio !== undefined ? <small>当座比率 {quickRatio.toFixed(1)}%</small> : <small>データがある場合のみ表示</small>}</div>
    </dl> : <div class="empty-inline">この企業の流動性指標は準備中です。</div>}
    {healthMetrics.some((metric) => metric.note) && <p class="section-note">金融事業を含む企業など、資産・負債の構成が一般的な事業会社と異なる場合があります。</p>}
  </section>

  <section>
    <div class="section-head">
      <h2>資産状況・IR推移</h2>
      <p>売上、利益、キャッシュフローなどを表で確認できます。単位・対象範囲は指標ごとに異なります。</p>
    </div>
    <FinancialHistoryTable
      metrics={financialMetrics}
      metricKeys={financialMetricKeys}
      annotations={companyAnnotations}
    />
  </section>

  {financialMetrics.length > 0 && <MetricExplorer
    companies={[company]}
    metrics={financialMetrics}
    explorerId={`company-explorer-${company.company_id}`}
    initialMetricKey="revenue"
    annotations={companyAnnotations}
  />}

  {companySources.length > 0 && <section>
    <div class="section-head"><h2>出典</h2><p>数値は法定開示・公式資料をもとにしています。</p></div>
    <div class="source-list">
      {companySources.map((source) => <a href={source.url} target="_blank" rel="noreferrer">
        <div><strong>{source.title}</strong><span>{source.issuer}</span></div>
        <div><span>公開 {source.published_at}</span><span>取得 {source.retrieved_at}</span></div>
      </a>)}
    </div>
  </section>}
</BaseLayout>
