---
import CompanySortControls from "../../components/CompanySortControls.astro";
import type { SortOption } from "../../components/CompanySortControls.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { companies, disclosureIdForCompany, metricsForCompanies } from "../../lib/data";
import {
  companyPageAddedAt,
  companyPageUpdatedAt,
  formatUpdatedAt,
} from "../../lib/company-pages";
import { formatValue, latestMetric, metricLabels, metricNotes } from "../../lib/format";
import { normalizeForSearch } from "../../lib/search";

const companyPages = import.meta.glob("./*.mdx");
const pageIds = new Set(
  Object.keys(companyPages).map((path) =>
    path.replace("./", "").replace(".mdx", ""),
  ),
);

const allMetrics = metricsForCompanies(
  companies.map((company) => disclosureIdForCompany(company)),
);
const metricYears = allMetrics.map((metric) => Number(metric.fiscal_year));
const latestYear = metricYears.length ? Math.max(...metricYears) : undefined;

// 各行のカードに出す指標
const listedKeys = [
  "average_annual_salary",
  "average_tenure",
  "average_age",
  "employee_count",
] as const;

// カードには出さず、分布パネルでだけ選べる働き方の指標
const humanCapitalKeys = [
  "gender_pay_gap",
  "female_manager_ratio",
  "male_childcare_leave_rate",
  "male_childcare_leave_rate_with_leave",
] as const;

const latestKeys = [...listedKeys, ...humanCapitalKeys] as const;

const collator = new Intl.Collator("ja");
const rows = companies
  .map((company) => {
    const disclosureId = disclosureIdForCompany(company);
    const companyMetrics = allMetrics.filter(
      (metric) => metric.company_id === disclosureId,
    );
    const updatedAt = companyPageUpdatedAt(company.company_id);
    const addedAt = companyPageAddedAt(company.company_id);
    return {
      company,
      // company_id はローマ字表記なので、英字での検索もここで拾える
      searchKey: [
        company.display_name,
        company.name_kana,
        company.legal_name,
        company.company_id,
      ]
        .map(normalizeForSearch)
        .join("/"),
      hasPage: pageIds.has(company.company_id),
      addedAt: addedAt ? Date.parse(addedAt) : undefined,
      updatedAt: updatedAt ? formatUpdatedAt(updatedAt) : undefined,
      latest: Object.fromEntries(
        // 従業員数は連結と単体の両方を持つため、一覧では連結に揃える
        latestKeys.map((key) => [
          key,
          latestMetric(
            companyMetrics,
            key,
            key === "employee_count" ? "consolidated" : undefined,
          ),
        ]),
      ) as Record<(typeof latestKeys)[number], ReturnType<typeof latestMetric>>,
    };
  })
  .sort((a, b) => collator.compare(a.company.name_kana, b.company.name_kana));

// 既定の軸を左端に、五十音順を右端に置く
const sortOptions: SortOption[] = [
  {
    value: "salary",
    label: "平均給与",
    asc: "平均年間給与の低い順で並べています。",
    desc: "平均年間給与の高い順で並べています。",
    defaultOrder: "desc",
  },
  {
    value: "tenure",
    label: "平均勤続年数",
    asc: "平均勤続年数の短い順で並べています。",
    desc: "平均勤続年数の長い順で並べています。",
    defaultOrder: "desc",
  },
  {
    value: "pay-gap",
    label: "男女の賃金の差異",
    asc: "男女の賃金の差異が大きい順（男性を100としたときの女性の水準が低い順）で並べています。",
    desc: "男女の賃金の差異が小さい順（男性を100としたときの女性の水準が高い順）で並べています。",
    defaultOrder: "desc",
  },
  {
    value: "female-managers",
    label: "女性管理職比率",
    asc: "女性管理職比率の低い順で並べています。",
    desc: "女性管理職比率の高い順で並べています。",
    defaultOrder: "desc",
  },
  {
    value: "childcare",
    label: "男性育休取得率（育児目的休暇を含まない）",
    asc: "男性育休取得率（育児目的休暇を含まない）の低い順で並べています。",
    desc: "男性育休取得率（育児目的休暇を含まない）の高い順で並べています。",
    defaultOrder: "desc",
  },
  {
    value: "childcare-with-leave",
    label: "男性育休取得率（育児目的休暇を含む）",
    asc: "男性育休取得率（育児目的休暇を含む）の低い順で並べています。",
    desc: "男性育休取得率（育児目的休暇を含む）の高い順で並べています。",
    defaultOrder: "desc",
  },
  {
    value: "added",
    label: "追加日時",
    asc: "記事の追加日時が古い順で並べています。",
    desc: "記事の追加日時が新しい順で並べています。",
    defaultOrder: "desc",
  },
  {
    value: "kana",
    label: "五十音順",
    asc: "五十音順（あ→ん）で並べています。",
    desc: "五十音順の逆（ん→あ）で並べています。",
    defaultOrder: "asc",
  },
];

// 従業員数は数百人から数十万人まで広がり、階級を等間隔で切ると1本の棒に潰れるため分布から外す。
// 指標名は業界ページの比較と揃えたいので metricLabels から引く
const distributionKeys = [
  {
    key: "average_annual_salary",
    axisTitle: "平均年間給与（万円）",
    scale: 10000,
    suffix: "万円",
    decimals: 0,
  },
  {
    key: "average_tenure",
    axisTitle: "平均勤続年数（年）",
    scale: 1,
    suffix: "年",
    decimals: 1,
  },
  {
    key: "average_age",
    axisTitle: "平均年齢（歳）",
    scale: 1,
    suffix: "歳",
    decimals: 1,
  },
  {
    key: "gender_pay_gap",
    axisTitle: "男女の賃金の差異（%）",
    scale: 1,
    suffix: "%",
    decimals: 1,
  },
  {
    key: "female_manager_ratio",
    axisTitle: "女性管理職比率（%）",
    scale: 1,
    suffix: "%",
    decimals: 1,
  },
  {
    key: "male_childcare_leave_rate",
    axisTitle: "男性育休取得率（育児目的休暇を含まない・%）",
    scale: 1,
    suffix: "%",
    decimals: 1,
  },
  {
    key: "male_childcare_leave_rate_with_leave",
    axisTitle: "男性育休取得率（育児目的休暇を含む・%）",
    scale: 1,
    suffix: "%",
    decimals: 1,
  },
] as const;

const distributionPayload = {
  totalCompanies: rows.length,
  metrics: distributionKeys.map((definition) => ({
    ...definition,
    label: metricLabels[definition.key] ?? definition.key,
    note: metricNotes[definition.key] ?? "",
    points: rows
      .filter((row) => row.latest[definition.key])
      .map((row) => ({
        name: row.company.display_name,
        value: Number(row.latest[definition.key]!.value),
      })),
  })),
};
---

<BaseLayout
  title="企業一覧"
  description="掲載企業の一覧。給与・勤続年数・働き方の指標について、並べ替えと分布から各社の位置を確認できます。"
>
  <section>
    <p class="breadcrumb"><a href="/">トップ</a><span>/</span>企業一覧</p>
    <div class="industry-head">
      <div>
        <h1>企業一覧</h1>
        <p class="lead">このサイトで掲載するすべての企業を定量的に比較できます。</p>
      </div>
      <dl class="facts">
        <div><dt>掲載企業</dt><dd>{rows.length}社</dd></div>
        <div><dt>最新データ</dt><dd>{latestYear ? `${latestYear}年度` : "—"}</dd></div>
      </dl>
    </div>
  </section>

  <section class="panel distribution-panel" data-distribution>
    <div class="section-head"><h2>指標の分布と代表値</h2></div>

    <label class="distribution-metric">
      <span>指標</span>
      <select data-distribution-metric>
        {
          distributionPayload.metrics.map((metric, index) => (
            <option value={metric.key} selected={index === 0}>{metric.label}</option>
          ))
        }
      </select>
    </label>

    <dl class="facts facts-boxed distribution-stats" aria-live="polite">
      <div><dt>中央値</dt><dd data-stat-median>—</dd></div>
      <div><dt>最頻値</dt><dd data-stat-mode>—</dd></div>
      <div><dt>平均値</dt><dd data-stat-mean>—</dd></div>
      <div><dt>集計対象</dt><dd data-stat-coverage>—</dd></div>
    </dl>

    <div class="chart-area distribution-chart" data-distribution-chart aria-live="polite"></div>

    <p class="chart-note">
      各社が公表した最新年度の値を等間隔の階級に区切って数えたヒストグラムです。最頻値は最も企業数が多い階級を範囲で示しており、濃い青の棒がその階級にあたります。縦の実線は中央値の位置です。
    </p>
    <p class="chart-note" data-distribution-note hidden></p>
    <p class="chart-note" data-distribution-outlier-note hidden></p>
  </section>

  <section>
    <div class="section-head"><h2>企業を探す</h2></div>

    <div class="company-search">
      <label>
        <span>企業名で絞り込む</span>
        <input
          type="search"
          data-company-search="companies"
          placeholder="社名・よみ・ローマ字（例: 富士通 / ふじつう / fujitsu）"
          autocomplete="off"
          enterkeyhint="search"
        />
      </label>
      <p class="search-status" data-search-status="companies" aria-live="polite">
        {rows.length}社を表示しています。
      </p>
    </div>

    <CompanySortControls controlsId="companies" options={sortOptions} initialSort="kana" />

    <div class="company-list" data-company-list="companies" data-sort="kana">
      {
        rows.map(({ company, searchKey, hasPage, addedAt, updatedAt, latest }, index) => {
          const salary = latest.average_annual_salary;
          const tenure = latest.average_tenure;
          const age = latest.average_age;
          const employees = latest.employee_count;
          // 働き方の指標は、その軸で並べているときだけ従業員数と入れ替えて出す
          const humanCapitalStats = [
            { stat: "pay-gap", metric: latest.gender_pay_gap, label: "男女の賃金の差異", note: "男性を100とした水準" },
            { stat: "female-managers", metric: latest.female_manager_ratio, label: "女性管理職比率" },
            { stat: "childcare", metric: latest.male_childcare_leave_rate, label: "男性育休取得率", note: "育児目的休暇を含まない" },
            { stat: "childcare-with-leave", metric: latest.male_childcare_leave_rate_with_leave, label: "男性育休取得率", note: "育児目的休暇を含む" },
          ];
          const stats = (
            <dl class="company-stats">
              <div data-stat="salary"><dt>平均年間給与</dt><dd>{salary ? formatValue(Number(salary.value), salary.unit) : "—"}</dd></div>
              <div data-stat="tenure"><dt>平均勤続年数</dt><dd>{tenure ? formatValue(Number(tenure.value), tenure.unit, tenure.metric_key) : "—"}</dd></div>
              <div data-stat="age"><dt>平均年齢</dt><dd>{age ? formatValue(Number(age.value), age.unit, age.metric_key) : "—"}</dd></div>
              <div data-stat="employees"><dt>従業員数</dt><dd>{employees ? formatValue(Number(employees.value), employees.unit) : "—"}</dd></div>
              {humanCapitalStats.map(({ stat, metric, label, note }) => (
                <div data-stat={stat} data-stat-optional>
                  <dt>{label}</dt>
                  <dd>{metric ? formatValue(Number(metric.value), metric.unit, metric.metric_key) : "—"}{note && <small>{note}</small>}</dd>
                </div>
              ))}
            </dl>
          );
          const heading = (
            <div>
              <h3>{company.display_name}</h3>
              <p class="legal-name">{hasPage ? company.legal_name : `${company.legal_name}（ページ準備中）`}</p>
              {hasPage && updatedAt && <p class="row-updated">記事更新 {updatedAt}</p>}
            </div>
          );
          const dataAttributes = {
            "data-search-key": searchKey,
            "data-sort-kana": index,
            "data-sort-added": addedAt ?? "",
            "data-sort-salary": salary ? salary.value : "",
            "data-sort-tenure": tenure ? tenure.value : "",
            ...Object.fromEntries(
              humanCapitalStats.map(({ stat, metric }) => [
                `data-sort-${stat}`,
                metric ? metric.value : "",
              ]),
            ),
          };

          return hasPage ? (
            <a class="linked-row" href={`/companies/${company.company_id}/`} {...dataAttributes}>
              {heading}
              {stats}
            </a>
          ) : (
            <div class="linked-row card-soon" {...dataAttributes}>
              {heading}
              {stats}
            </div>
          );
        })
      }
    </div>
    <p class="empty-state search-empty" data-search-empty="companies" hidden>
      該当する企業がありません。
    </p>
    <p class="section-note">
      平均年間給与・平均勤続年数・平均年齢・従業員数は、有価証券報告書などで各社が公表した最新年度の値です。持株会社では提出会社単体の値であることが多く、グループ全体や採用主体の待遇とは一致しない場合があります。値を公表していない企業は、順序によらず末尾に並べています。
    </p>
  </section>
</BaseLayout>

<style>
  .company-search { margin-bottom: 18px; }
  .company-search > label { display: block; max-width: 420px; }
  .company-search span { display: block; margin-bottom: 6px; color: var(--muted); font-size: 12px; }
  .company-search input {
    width: 100%; height: 38px; padding: 0 12px;
    color: var(--ink); background: white; border: 1px solid var(--line-dark); border-radius: 6px;
    font: inherit; font-size: 14px;
  }
  .company-search input::placeholder { color: var(--muted); }
  :global([data-theme="dark"]) .company-search input { background: #172131; }
  .search-status { margin: 10px 0 0; color: var(--muted); font-size: 13px; }
  .search-empty { min-height: 120px; }
  /* .linked-row は grid のため、hidden 属性だけでは隠れない */
  .company-list > [hidden], .search-empty[hidden] { display: none; }

  /* 働き方の指標は、その軸で並べているときだけ従業員数と入れ替えて出し、カードを4列に保つ */
  .company-stats > [data-stat-optional] { display: none; }
  .company-list:is(
    [data-sort="pay-gap"], [data-sort="female-managers"],
    [data-sort="childcare"], [data-sort="childcare-with-leave"]
  ) .company-stats > [data-stat="employees"] { display: none; }
  .company-list[data-sort="pay-gap"] .company-stats > [data-stat="pay-gap"],
  .company-list[data-sort="female-managers"] .company-stats > [data-stat="female-managers"],
  .company-list[data-sort="childcare"] .company-stats > [data-stat="childcare"],
  .company-list[data-sort="childcare-with-leave"] .company-stats > [data-stat="childcare-with-leave"] {
    display: block;
  }

  .distribution-panel { margin-bottom: 34px; }
  /* 「男性育休取得率（育児目的休暇を含まない）」が閉じた状態でも読める幅 */
  .distribution-metric { display: block; max-width: 340px; margin-bottom: 18px; }
  .distribution-metric > span { display: block; margin-bottom: 6px; color: var(--muted); font-size: 12px; }
  .distribution-metric select {
    width: 100%; height: 38px; padding: 0 10px;
    color: var(--ink); background: white; border: 1px solid var(--line-dark); border-radius: 6px;
    font: inherit; font-size: 14px;
  }
  :global([data-theme="dark"]) .distribution-metric select {
    background: #172131;
  }

  .distribution-stats { margin-bottom: 18px; }
  .distribution-stats dd { font-size: 19px; font-weight: 700; letter-spacing: -.02em; }

  .distribution-chart { min-height: 0; padding: 18px 16px 12px; }

  /* ヒストグラムはライト/ダークとも単一色相の2段で、濃い側が最頻値階級 */
  .distribution-panel {
    --hist-bar: #86b6ef;
    --hist-bar-strong: #2563eb;
    --hist-rule: #101828;
    --hist-axis: #5b6b82;
    --hist-surface: white;
  }
  :global([data-theme="dark"]) .distribution-panel {
    --hist-bar: #2f6bbf;
    --hist-bar-strong: #6ba3ff;
    --hist-rule: #e8edf5;
    --hist-axis: #a8b3c3;
    --hist-surface: #172131;
  }

  .distribution-chart :global(.histogram) { display: block; width: 100%; height: auto; }
  .distribution-chart :global(.hist-bar) { fill: var(--hist-bar); }
  .distribution-chart :global(.hist-bar.is-mode) { fill: var(--hist-bar-strong); }
  .distribution-chart :global(.hist-hit) { fill: transparent; outline: none; }
  .distribution-chart :global(.hist-bar.is-hovered) { opacity: .78; }
  .distribution-chart :global(.hist-baseline) { stroke: var(--line-dark); stroke-width: 1; }
  .distribution-chart :global(.hist-median) { stroke: var(--hist-rule); stroke-width: 2; }
  /* 中央値の線と重なっても読めるよう、ラベルに背景色のふちどりを敷く */
  .distribution-chart :global(.hist-count),
  .distribution-chart :global(.hist-median-label) {
    paint-order: stroke;
    stroke: var(--hist-surface);
    stroke-width: 3px;
    stroke-linejoin: round;
  }
  .distribution-chart :global(.hist-count) { fill: var(--hist-axis); font: 11px sans-serif; }
  .distribution-chart :global(.hist-count.is-mode) { fill: var(--hist-rule); font-weight: 700; }
  .distribution-chart :global(.hist-tick) { fill: var(--hist-axis); font: 11px sans-serif; font-variant-numeric: tabular-nums; }
  .distribution-chart :global(.hist-title) { fill: var(--hist-axis); font: 11px sans-serif; }
  .distribution-chart :global(.hist-median-label) { fill: var(--hist-rule); font: 700 11px sans-serif; }

  /* モバイルは既存CSSで先頭の指標だけが残るため、並び替え中の指標を先頭へ寄せて表示する */
  @media (max-width: 720px) {
    .company-list:is(
      [data-sort="tenure"], [data-sort="pay-gap"], [data-sort="female-managers"],
      [data-sort="childcare"], [data-sort="childcare-with-leave"]
    ) .company-stats > div[data-stat="salary"] {
      display: none;
    }
    .company-list[data-sort="tenure"] .company-stats > div[data-stat="tenure"],
    .company-list[data-sort="pay-gap"] .company-stats > [data-stat="pay-gap"],
    .company-list[data-sort="female-managers"] .company-stats > [data-stat="female-managers"],
    .company-list[data-sort="childcare"] .company-stats > [data-stat="childcare"],
    .company-list[data-sort="childcare-with-leave"] .company-stats > [data-stat="childcare-with-leave"] {
      display: flex;
      align-items: baseline;
      gap: 8px;
    }
    /* 1行に収めるため、算定範囲の補足は畳む */
    .company-list .company-stats dd small { display: none; }
    .distribution-stats > div { flex-basis: 50%; }
  }
</style>


<script is:inline define:vars={{ distributionPayload }}>
  (() => {
    const root = document.querySelector("[data-distribution]");
    if (!root) return;
    const chart = root.querySelector("[data-distribution-chart]");
    const select = root.querySelector("[data-distribution-metric]");

    const escapeHtml = (value) =>
      String(value)
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;");

    const formatScaled = (value, metric) =>
      `${(value / metric.scale).toLocaleString("ja-JP", {
        minimumFractionDigits: metric.decimals,
        maximumFractionDigits: metric.decimals,
      })}${metric.suffix}`;

    const formatTick = (value, metric) =>
      (value / metric.scale).toLocaleString("ja-JP", {
        maximumFractionDigits: 1,
      });

    const median = (values) => {
      const sorted = [...values].sort((a, b) => a - b);
      const middle = Math.floor(sorted.length / 2);
      return sorted.length % 2
        ? sorted[middle]
        : (sorted[middle - 1] + sorted[middle]) / 2;
    };

    // 目盛りが読める幅に丸めた階級幅。10のべき乗に1/2/2.5/5を掛けた値から選ぶ
    const niceBinWidth = (range, targetBins) => {
      if (range <= 0) return 1;
      const raw = range / targetBins;
      const magnitude = 10 ** Math.floor(Math.log10(raw));
      const normalized = raw / magnitude;
      const step = [1, 2, 2.5, 5, 10].find((candidate) => normalized <= candidate) ?? 10;
      return step * magnitude;
    };

    // 階級のうちどれだけが空なら、上側の極端な値に横軸を引き延ばされていると見なすか。
    // 男性育休取得率のように300%台の公表値があると、残りの企業が数本の棒に潰れてしまう
    const overflowEmptyRatio = 1 / 3;

    // 箱ひげ図と同じ Q3 + 1.5×IQR。極端な値そのものを外れ値として切り出す
    const upperFence = (values) => {
      const sorted = [...values].sort((a, b) => a - b);
      const quantile = (ratio) => {
        const position = (sorted.length - 1) * ratio;
        const lower = Math.floor(position);
        const upper = Math.ceil(position);
        return lower === upper
          ? sorted[lower]
          : sorted[lower] + (sorted[upper] - sorted[lower]) * (position - lower);
      };
      const first = quantile(0.25);
      const third = quantile(0.75);
      return third + 1.5 * (third - first);
    };

    const fillBins = (points, start, width, count, hasOverflow) => {
      const bins = Array.from(
        { length: count + (hasOverflow ? 1 : 0) },
        (_, index) => ({
          from: start + index * width,
          to: start + (index + 1) * width,
          // 最上位の階級だけは上限を持たず、これを超える値をすべて受け止める
          overflow: hasOverflow && index === count,
          points: [],
        }),
      );
      for (const point of points) {
        const index = Math.min(
          Math.floor((point.value - start) / width),
          bins.length - 1,
        );
        bins[index].points.push(point);
      }
      return bins;
    };

    const buildBins = (points) => {
      const values = points.map((point) => point.value);
      const min = Math.min(...values);
      const max = Math.max(...values);
      const width = niceBinWidth(max - min, 12);
      const start = Math.floor(min / width) * width;
      const count = Math.max(Math.ceil((max - start) / width), 1);
      const evenBins = fillBins(points, start, width, count, false);

      const emptyRatio =
        evenBins.filter((bin) => !bin.points.length).length / evenBins.length;
      if (emptyRatio <= overflowEmptyRatio) return evenBins;

      const fence = upperFence(values);
      const inner = values.filter((value) => value <= fence);
      if (!inner.length || inner.length === values.length) return evenBins;

      const innerMax = Math.max(...inner);
      const innerWidth = niceBinWidth(innerMax - min, 12);
      // 外れ値をまとめても階級が細かくならないなら、素直な等間隔のままにする
      if (innerWidth >= width) return evenBins;

      const innerStart = Math.floor(min / innerWidth) * innerWidth;
      const innerCount = Math.max(
        Math.floor((innerMax - innerStart) / innerWidth) + 1,
        1,
      );
      return fillBins(points, innerStart, innerWidth, innerCount, true);
    };

    const formatBinRange = (bin, metric) =>
      bin.overflow
        ? `${formatScaled(bin.from, metric)}以上`
        : `${formatTick(bin.from, metric)}〜${formatScaled(bin.to, metric)}`;

    const barPath = (x, y, width, height, radius) => {
      const r = Math.max(Math.min(radius, width / 2, height), 0);
      const bottom = y + height;
      return `M${x},${bottom} L${x},${y + r} Q${x},${y} ${x + r},${y} L${x + width - r},${y} Q${x + width},${y} ${x + width},${y + r} L${x + width},${bottom} Z`;
    };

    const outlierNote = root.querySelector("[data-distribution-outlier-note]");

    const render = (metric) => {
      if (!metric.points.length) {
        chart.innerHTML = '<p class="empty-state">分布を描ける公表値がありません。</p>';
        root.querySelector("[data-stat-median]").textContent = "—";
        root.querySelector("[data-stat-mode]").textContent = "—";
        root.querySelector("[data-stat-mean]").textContent = "—";
        root.querySelector("[data-stat-coverage]").textContent =
          `0社 / ${distributionPayload.totalCompanies}社`;
        outlierNote.hidden = true;
        return;
      }

      const values = metric.points.map((point) => point.value);
      const bins = buildBins(metric.points);
      const overflowBin = bins.at(-1).overflow ? bins.at(-1) : undefined;
      outlierNote.textContent = overflowBin
        ? `右端は${formatScaled(overflowBin.from, metric)}以上の${overflowBin.points.length}社をまとめた階級です。この範囲まで等間隔で刻むと、残りの企業が数本の棒に潰れて分布を読めなくなるためです。`
        : "";
      outlierNote.hidden = !overflowBin;

      const maxCount = Math.max(...bins.map((bin) => bin.points.length));
      const modeIndex = bins.findIndex((bin) => bin.points.length === maxCount);
      const modeBin = bins[modeIndex];
      const medianValue = median(values);
      const meanValue = values.reduce((sum, value) => sum + value, 0) / values.length;

      root.querySelector("[data-stat-median]").textContent = formatScaled(medianValue, metric);
      root.querySelector("[data-stat-mode]").textContent = formatBinRange(modeBin, metric);
      root.querySelector("[data-stat-mean]").textContent = formatScaled(meanValue, metric);
      root.querySelector("[data-stat-coverage]").textContent =
        `${metric.points.length}社 / ${distributionPayload.totalCompanies}社`;

      const width = 760;
      const height = 320;
      const padLeft = 20;
      const padRight = 20;
      const plotTop = 40;
      const plotBottom = 264;
      const plotWidth = width - padLeft - padRight;
      const plotHeight = plotBottom - plotTop;
      // 最も高い棒の件数ラベルが中央値ラベルとぶつからないよう、棒の上に帯を空ける
      const labelBand = 18;
      const barArea = plotHeight - labelBand;
      const slot = plotWidth / bins.length;
      const gap = Math.min(3, slot * 0.18);
      const barWidth = slot - gap;
      const scaleX = (value) =>
        padLeft + ((value - bins[0].from) / (bins.at(-1).to - bins[0].from)) * plotWidth;

      const bars = [];
      const countLabels = [];
      bins.forEach((bin, index) => {
        const count = bin.points.length;
        if (!count) return;
        const x = padLeft + index * slot + gap / 2;
        const barHeight = (count / maxCount) * barArea;
        const y = plotBottom - barHeight;
        const isMode = index === modeIndex;
        bars.push(
          `<path class="hist-bar${isMode ? " is-mode" : ""}" data-bin="${index}" d="${barPath(x, y, barWidth, barHeight, 4)}"/>`,
        );
        countLabels.push(
          `<text class="hist-count${isMode ? " is-mode" : ""}" x="${x + barWidth / 2}" y="${y - 7}" text-anchor="middle">${count}</text>`,
        );
      });

      // 棒が細くても掴めるよう、階級の全高を当たり判定にする
      const hits = bins.map((bin, index) => {
        const names = bin.points.map((point) => point.name);
        const shown = names.slice(0, 8).join("、");
        const rest = names.length > 8 ? `　ほか${names.length - 8}社` : "";
        const range = formatBinRange(bin, metric);
        return `<rect class="hist-hit" x="${padLeft + index * slot}" y="${plotTop}" width="${slot}" height="${plotHeight}"
          data-bin="${index}"
          data-range="${escapeHtml(range)}"
          data-count="${bin.points.length}"
          data-names="${escapeHtml(shown + rest)}" tabindex="0" role="img"
          aria-label="${escapeHtml(`${range} ${bin.points.length}社`)}"></rect>`;
      }).join("");

      const tickStep = bins.length > 14 ? 2 : 1;
      const tickValues = bins.map((bin) => bin.from);
      // 最上位が「◯◯以上」の階級のときは、右端に目盛りを置くと上限があるように見える
      if (!overflowBin) tickValues.push(bins.at(-1).to);
      const ticks = tickValues
        .map((value, index, all) => {
          if (index % tickStep !== 0 && index !== all.length - 1) return "";
          return `<text class="hist-tick" x="${scaleX(value)}" y="${plotBottom + 20}" text-anchor="middle">${escapeHtml(formatTick(value, metric))}</text>`;
        })
        .join("");

      const medianX = scaleX(medianValue);
      const medianAnchor =
        medianX > width - padRight - 70 ? "end" : medianX < padLeft + 70 ? "start" : "middle";
      const medianLine = `<line class="hist-median" x1="${medianX}" y1="${plotTop}" x2="${medianX}" y2="${plotBottom}"/>`;
      const medianLabel = `<text class="hist-median-label" x="${medianX}" y="${plotTop - 9}" text-anchor="${medianAnchor}">中央値 ${escapeHtml(formatScaled(medianValue, metric))}</text>`;

      chart.innerHTML = `
        <svg class="histogram" viewBox="0 0 ${width} ${height}" role="img"
          aria-label="${escapeHtml(`${metric.label}の分布。${metric.points.length}社を階級ごとに数えたヒストグラム`)}">
          <line class="hist-baseline" x1="${padLeft}" y1="${plotBottom}" x2="${width - padRight}" y2="${plotBottom}"/>
          ${bars.join("")}${medianLine}${countLabels.join("")}${medianLabel}${ticks}
          <text class="hist-title" x="${width - padRight}" y="${height - 8}" text-anchor="end">${escapeHtml(metric.axisTitle)}</text>
          <text class="hist-title" x="${padLeft}" y="${height - 8}">縦軸は企業数</text>
          ${hits}
        </svg>
        <div class="chart-tooltip" data-chart-tooltip role="status"></div>`;

      const tooltip = chart.querySelector("[data-chart-tooltip]");
      const showTooltip = (hit, clientX) => {
        const chartRect = chart.getBoundingClientRect();
        const hitRect = hit.getBoundingClientRect();
        tooltip.innerHTML =
          `<strong>${escapeHtml(hit.dataset.range)}　${escapeHtml(hit.dataset.count)}社</strong>` +
          (hit.dataset.names ? `<span>${escapeHtml(hit.dataset.names)}</span>` : "");
        const halfWidth = tooltip.offsetWidth / 2;
        const relativeX = (clientX ?? hitRect.left + hitRect.width / 2) - chartRect.left;
        tooltip.style.left = `${Math.min(Math.max(relativeX, halfWidth + 4), chartRect.width - halfWidth - 4)}px`;
        tooltip.style.top = `${hitRect.top - chartRect.top + 24}px`;
        tooltip.classList.add("is-visible");
      };
      const hideTooltip = () => {
        tooltip.classList.remove("is-visible");
        chart.querySelectorAll(".hist-bar.is-hovered").forEach((bar) =>
          bar.classList.remove("is-hovered"),
        );
      };

      chart.querySelectorAll(".hist-hit").forEach((hit) => {
        // 当たり判定は棒の上に重ねる必要があり兄弟セレクタが使えないため、対応する棒を直接指す
        const bar = chart.querySelector(`.hist-bar[data-bin="${hit.dataset.bin}"]`);
        const enter = (clientX) => {
          bar?.classList.add("is-hovered");
          showTooltip(hit, clientX);
        };
        hit.addEventListener("mouseenter", (event) => enter(event.clientX));
        hit.addEventListener("mousemove", (event) => enter(event.clientX));
        hit.addEventListener("mouseleave", hideTooltip);
        hit.addEventListener("focus", () => enter(undefined));
        hit.addEventListener("blur", hideTooltip);
      });
    };

    const note = root.querySelector("[data-distribution-note]");

    const update = () => {
      const metric =
        distributionPayload.metrics.find((item) => item.key === select.value) ??
        distributionPayload.metrics[0];
      note.textContent = metric.note;
      note.hidden = !metric.note;
      render(metric);
    };

    select.addEventListener("change", update);
    update();
  })();
</script>

<script>
  import { normalizeForSearch } from "../../lib/search";

  for (const input of document.querySelectorAll<HTMLInputElement>(
    "[data-company-search]",
  )) {
    const id = input.dataset.companySearch;
    const list = document.querySelector<HTMLElement>(
      `[data-company-list="${id}"]`,
    );
    const status = document.querySelector<HTMLElement>(
      `[data-search-status="${id}"]`,
    );
    const empty = document.querySelector<HTMLElement>(
      `[data-search-empty="${id}"]`,
    );
    if (!list) continue;

    const rows = [...list.children].filter(
      (child): child is HTMLElement => child instanceof HTMLElement,
    );

    const applyFilter = () => {
      // 正規化で空白が落ちるため、語の分割は正規化の前に済ませる
      const terms = input.value
        .trim()
        .split(/\s+/)
        .map(normalizeForSearch)
        .filter(Boolean);

      let shown = 0;
      for (const row of rows) {
        const key = row.dataset.searchKey ?? "";
        const matched = terms.every((term) => key.includes(term));
        row.hidden = !matched;
        if (matched) shown += 1;
      }

      if (empty) empty.hidden = shown > 0;
      if (status) {
        status.textContent = terms.length
          ? `${rows.length}社のうち${shown}社が該当しました。`
          : `${rows.length}社を表示しています。`;
      }
    };

    input.addEventListener("input", applyFilter);
    // ブラウザが入力値を復元した場合に備え、読み込み直後にも一度合わせる
    applyFilter();
  }
</script>
