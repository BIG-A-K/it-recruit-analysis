---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  companies,
  companiesForIndustry,
  industries,
  metrics,
} from "../lib/data";

const industryCards = industries.map((industry) => ({
  ...industry,
  companies: companiesForIndustry(industry.industry_id),
}));
const reported = metrics.filter((metric) => metric.availability === "reported");
const latestYear = Math.max(
  ...reported.map((metric) => Number(metric.fiscal_year)),
);
const metricCount = new Set(reported.map((metric) => metric.metric_key)).size;
---

<BaseLayout>
  <section class="hero">
    <h1>情報系の学生のための企業分析サイト</h1>
    <p class="lead">
      このサイトは私、<a href="https://www.big-a-k.com/" target="_blank">黒田幸者</a>が趣味として、IT関連企業を分析してまとめたものです。誤りや不正確な箇所があるかも知れません。ご了承ください。
    </p>
    <p class="lead">
      IT業界と一言でいっても、その事業内容は多岐にわたります。ハードウェアそのものを作る企業、それを仕入れて届ける企業、導入から運用・保守までを引き受ける企業といったBtoBの世界があり、一方でwebなどを通じて一般の利用者にサービスを届けるBtoCの世界もあります。
    </p>
    <p class="lead">
      このサイトでは、そうした業界ごとの違いを紹介しつつ、代表的な企業の事業内容や待遇、健全性指標を比較できるようにまとめています。これから就職活動をしようと思っている方に役立つことを願っています。
    </p>

    <dl class="facts">
      <div><dt>掲載企業</dt><dd>{companies.length}社</dd></div>
      <div><dt>業界</dt><dd>{industries.length}</dd></div>
      <div><dt>比較指標</dt><dd>{metricCount}項目</dd></div>
      <div><dt>最新データ</dt><dd>{latestYear}年度</dd></div>
    </dl>
  </section>

  <section id="industries">
    <div class="section-head"><h2>業界から探す</h2></div>
    <div class="industry-grid">
      {
        industryCards.map((industry) => (
          <a class="card" href={`/industries/${industry.industry_id}/`}>
            <h3>{industry.name}</h3>
            <span class="card-count">{industry.companies.length}社</span>
            <p>{industry.description || industry.classification_basis}</p>
          </a>
        ))
      }
    </div>
  </section>

</BaseLayout>
