---
import type { GetStaticPaths } from "astro";
import CompanySortControls from "../../components/CompanySortControls.astro";
import type { SortOption } from "../../components/CompanySortControls.astro";
import MetricExplorer from "../../components/MetricExplorer.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  companiesForIndustry,
  industries,
  metricsForCompanies,
} from "../../lib/data";
import type { Metric } from "../../lib/data";
import { companyPageUpdatedAt, formatUpdatedAt } from "../../lib/company-pages";
import { formatValue, latestMetric, metricLabels } from "../../lib/format";

export const getStaticPaths = (() =>
  industries.map((industry) => ({
    params: { industryId: industry.industry_id },
    props: { industry },
  }))) satisfies GetStaticPaths;

const { industry } = Astro.props;
const baseCompanies = companiesForIndustry(industry.industry_id);
const relatedMetrics = metricsForCompanies(
  baseCompanies.map((company) => company.company_id),
);
const metricIdentity = (metric: Metric) =>
  [
    metric.fiscal_year,
    metric.period_end,
    metric.scope,
    metric.accounting_standard,
  ].join("\u0000");
const currentRatios = baseCompanies.flatMap((company) => {
  const companyMetrics = relatedMetrics.filter(
    (metric) => metric.company_id === company.company_id,
  );
  const assets = new Map(
    companyMetrics
      .filter((metric) => metric.metric_key === "current_assets")
      .map((metric) => [metricIdentity(metric), metric]),
  );
  const liabilities = new Map(
    companyMetrics
      .filter((metric) => metric.metric_key === "current_liabilities")
      .map((metric) => [metricIdentity(metric), metric]),
  );

  return [...assets.entries()].flatMap(([identity, asset]) => {
    const liability = liabilities.get(identity);
    if (!liability || Number(liability.value) === 0) return [];

    return [{
      ...asset,
      metric_key: "current_ratio",
      value: String(
        (Number(asset.value) / Number(liability.value) * 100).toFixed(6),
      ),
      unit: "percent",
      note: "流動資産 / 流動負債 × 100（サイト算出値）",
    }];
  });
});
const industryMetrics = [...relatedMetrics, ...currentRatios];
const metricYears = industryMetrics.map((metric) =>
  Number(metric.fiscal_year),
);
const latestYear = metricYears.length ? Math.max(...metricYears) : undefined;

const collator = new Intl.Collator("ja");
const kanaRanks = new Map(
  [...baseCompanies]
    .sort((a, b) => collator.compare(a.name_kana, b.name_kana))
    .map((company, index) => [company.company_id, index]),
);

const sortedCompanies = baseCompanies
  .map((company) => {
     const companyMetrics = industryMetrics.filter(
       (metric) => metric.company_id === company.company_id,
     );
     const updatedAt = companyPageUpdatedAt(company.company_id);
     return {
       company,
       kanaRank: kanaRanks.get(company.company_id) ?? 0,
       updatedAt: updatedAt ? formatUpdatedAt(updatedAt) : undefined,
       salary: latestMetric(companyMetrics, "average_annual_salary"),
       netCashFlow: latestMetric(companyMetrics, "net_cf"),
       // 重工各社のように営業利益を開示せず事業利益で開示する企業があるため、
       // 定義の違う値を同じ見出しへまとめず、見出しごと指標に合わせる
       operatingProfit:
         latestMetric(companyMetrics, "operating_profit") ??
         latestMetric(companyMetrics, "business_profit"),
       currentRatio: latestMetric(companyMetrics, "current_ratio"),
     };
  })
  .sort((a, b) => {
    // 初期表示は並び替えコントロールの初期状態（平均給与の降順）と揃える
    const av = a.salary ? Number(a.salary.value) : null;
    const bv = b.salary ? Number(b.salary.value) : null;
    if (av === null && bv === null) return a.kanaRank - b.kanaRank;
    if (av === null) return 1;
    if (bv === null) return -1;
    return bv - av || a.kanaRank - b.kanaRank;
  });

const sortOptions: SortOption[] = [
  {
    value: "kana",
    label: "五十音順",
    asc: "五十音順（あ→ん）で並べています。",
    desc: "五十音順の逆（ん→あ）で並べています。",
    defaultOrder: "asc",
  },
  {
    value: "salary",
    label: "平均給与",
    asc: "平均年間給与の低い順で並べています。",
    desc: "平均年間給与の高い順で並べています。",
    defaultOrder: "desc",
  },
  {
    value: "netcf",
    label: "ネットCF",
    asc: "ネットCFの小さい順で並べています。",
    desc: "ネットCFの大きい順で並べています。",
    defaultOrder: "desc",
  },
  {
    value: "profit",
    label: "利益",
    asc: "各社が表示している営業利益・事業利益の小さい順で並べています。",
    desc: "各社が表示している営業利益・事業利益の大きい順で並べています。",
    defaultOrder: "desc",
  },
  {
    value: "ratio",
    label: "流動比率",
    asc: "流動比率の低い順で並べています。",
    desc: "流動比率の高い順で並べています。",
    defaultOrder: "desc",
  },
];
---

<BaseLayout
  title={industry.name}
  description={`${industry.name}の企業比較。給与・財務・キャッシュフロー・流動比率を年度別に確認できます。`}
>
  <section>
    <p class="breadcrumb">
      <a href="/">トップ</a><span>/</span><a href="/industries/">業界一覧</a><span>/</span>{industry.name}
    </p>
    <div class="industry-head">
      <div>
        <h1>{industry.name}</h1>
        {industry.description && <p class="lead">{industry.description}</p>}
      </div>
      <dl class="facts">
        <div><dt>掲載企業</dt><dd>{baseCompanies.length}社</dd></div>
        <div><dt>最新データ</dt><dd>{latestYear ? `${latestYear}年度` : "—"}</dd></div>
      </dl>
    </div>
    <p class="classification">
      <strong>分類の基準</strong>{industry.classification_basis}。企業は複数の業界に所属する場合があります。
    </p>
  </section>

  {industryMetrics.length > 0 ? <MetricExplorer
     companies={baseCompanies}
     metrics={industryMetrics}
     explorerId={`explorer-${industry.industry_id}`}
     initialView="bar"
   /> : <section>
    <div class="section-head"><h2>指標を切り替えて比較する</h2></div>
     <div class="empty-inline">この業界の企業は非上場などにより財務指標の公表がなく、横断比較はできません。各社の採用情報や事業内容は企業詳細ページをご確認ください。</div>
   </section>}
  {currentRatios.length > 0 && <p class="section-note">流動比率は、同じ年度・対象範囲・会計基準の流動資産を流動負債で割って100を掛けたサイト算出値です。</p>}

  <section>
    <div class="section-head"><h2>この業界の企業</h2></div>
    <CompanySortControls
      controlsId={`industry-${industry.industry_id}`}
      options={sortOptions}
      initialSort="salary"
    />
    <div class="company-list" data-company-list={`industry-${industry.industry_id}`}>
      {
        sortedCompanies.map(({ company, kanaRank, updatedAt, salary, netCashFlow, operatingProfit, currentRatio }) => {
          return (
            <a
              class="linked-row"
              href={`/companies/${company.company_id}/`}
              data-sort-kana={kanaRank}
              data-sort-salary={salary ? salary.value : ""}
              data-sort-netcf={netCashFlow ? netCashFlow.value : ""}
              data-sort-profit={operatingProfit ? operatingProfit.value : ""}
              data-sort-ratio={currentRatio ? currentRatio.value : ""}
            >
              <div>
                <h3>{company.display_name}</h3>
                <p class="legal-name">{company.legal_name}</p>
                {updatedAt && <p class="row-updated">記事更新 {updatedAt}</p>}
              </div>
              <dl class="company-stats">
                <div><dt>平均年間給与</dt><dd>{salary ? formatValue(Number(salary.value), salary.unit) : "—"}</dd></div>
                <div><dt>ネットCF</dt><dd>{netCashFlow ? formatValue(Number(netCashFlow.value), netCashFlow.unit) : "—"}</dd></div>
                <div><dt>{operatingProfit ? metricLabels[operatingProfit.metric_key] : "営業利益"}</dt><dd>{operatingProfit ? formatValue(Number(operatingProfit.value), operatingProfit.unit) : "—"}</dd></div>
                <div><dt>流動比率</dt><dd>{currentRatio ? formatValue(Number(currentRatio.value), currentRatio.unit, currentRatio.metric_key) : "—"}</dd></div>
              </dl>
            </a>
          );
        })
      }
    </div>
  </section>
</BaseLayout>
