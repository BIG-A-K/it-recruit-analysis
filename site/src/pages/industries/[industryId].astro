---
import type { GetStaticPaths, MDXInstance } from "astro";
import CompanySortControls from "../../components/CompanySortControls.astro";
import type { SortOption } from "../../components/CompanySortControls.astro";
import MetricExplorer from "../../components/MetricExplorer.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  companiesForIndustry,
  disclosureCompanyFor,
  disclosureIdForCompany,
  industries,
  metricsForCompanies,
} from "../../lib/data";
import type { Metric } from "../../lib/data";
import {
  companyPageAddedAt,
  companyPageUpdatedAt,
  formatUpdatedAt,
} from "../../lib/company-pages";
import { formatValue, latestMetric, metricLabels } from "../../lib/format";
import { withJpyEquivalent } from "../../lib/fx";
import type { MetricWithFx } from "../../lib/fx";

export const getStaticPaths = (() =>
  industries.map((industry) => ({
    params: { industryId: industry.industry_id },
    props: { industry },
  }))) satisfies GetStaticPaths;

// 手書きの業界解説。`_articles/<industry_id>.mdx` を置いた業界だけ本文が出る。
// `_` で始まるディレクトリは Astro がページとして扱わないため、ここから
// 読み込んで業界ページの一部として描画する。
const articleModules = import.meta.glob<MDXInstance<Record<string, unknown>>>(
  "./_articles/*.mdx",
  { eager: true },
);

const { industry } = Astro.props;
const IndustryArticle =
  articleModules[`./_articles/${industry.industry_id}.mdx`]?.Content;
const baseCompanies = companiesForIndustry(industry.industry_id);
const relatedMetrics = metricsForCompanies(
  baseCompanies.map((company) => disclosureIdForCompany(company)),
);
const metricIdentity = (metric: Metric) =>
  [
    metric.fiscal_year,
    metric.period_end,
    metric.scope,
    metric.accounting_standard,
  ].join("\u0000");
const currentRatios = baseCompanies.flatMap((company) => {
  const disclosureId = disclosureIdForCompany(company);
  const companyMetrics = relatedMetrics.filter(
    (metric) => metric.company_id === disclosureId,
  );
  const assets = new Map(
    companyMetrics
      .filter((metric) => metric.metric_key === "current_assets")
      .map((metric) => [metricIdentity(metric), metric]),
  );
  const liabilities = new Map(
    companyMetrics
      .filter((metric) => metric.metric_key === "current_liabilities")
      .map((metric) => [metricIdentity(metric), metric]),
  );

  return [...assets.entries()].flatMap(([identity, asset]) => {
    const liability = liabilities.get(identity);
    if (!liability || Number(liability.value) === 0) return [];

    return [{
      ...asset,
      metric_key: "current_ratio",
      value: String(
        (Number(asset.value) / Number(liability.value) * 100).toFixed(6),
      ),
      unit: "percent",
      note: "流動資産 / 流動負債 × 100（サイト算出値）",
    }];
  });
});
const industryMetrics = withJpyEquivalent([...relatedMetrics, ...currentRatios]);
const metricYears = industryMetrics.map((metric) =>
  Number(metric.fiscal_year),
);

// 一覧は通貨の違う企業が同じ列に並ぶため、表示と並び替えを円換算値に揃える。
// 換算した場合は公表値をそのまま読めるよう原通貨の額を併記する。
const comparableCell = (metric: MetricWithFx | undefined) => {
  if (!metric) return { text: "—", original: undefined, sortValue: "" };

  const reported = formatValue(
    Number(metric.value),
    metric.unit,
    metric.metric_key,
  );
  // 為替相場を用意していない年度は換算せず、公表値のまま並び替えの対象から外す
  if (metric.comparable_value === "") {
    return { text: reported, original: undefined, sortValue: "" };
  }

  const converted = metric.comparable_unit !== metric.unit;
  return {
    text: converted
      ? formatValue(
          Number(metric.comparable_value),
          metric.comparable_unit,
          metric.metric_key,
        )
      : reported,
    original: converted ? reported : undefined,
    sortValue: metric.comparable_value,
  };
};
const latestYear = metricYears.length ? Math.max(...metricYears) : undefined;

const collator = new Intl.Collator("ja");
const kanaRanks = new Map(
  [...baseCompanies]
    .sort((a, b) => collator.compare(a.name_kana, b.name_kana))
    .map((company, index) => [company.company_id, index]),
);

interface HumanCapitalStat {
  /** 行の `data-sort-<stat>` と `data-stat` に使うキー */
  stat: string;
  key: string;
  label: string;
  /** 算定範囲など、値だけでは読み違えるものへの補足 */
  note?: string;
  scope?: string;
}

// カードには常時出さず、その軸で並べているときだけ流動比率と入れ替えて出す指標。
// 企業一覧（/companies/）と同じ組み合わせ・同じ表示規則に揃える
const humanCapitalStats: HumanCapitalStat[] = [
  { stat: "tenure", key: "average_tenure", label: "平均勤続年数" },
  { stat: "age", key: "average_age", label: "平均年齢" },
  // 連結と単体の両方を持つ企業があるため、横並びでは連結に揃える
  { stat: "employees", key: "employee_count", label: "従業員数", scope: "consolidated" },
  { stat: "pay-gap", key: "gender_pay_gap", label: "男女の賃金の差異", note: "男性を100とした水準" },
  { stat: "female-managers", key: "female_manager_ratio", label: "女性管理職比率" },
  { stat: "childcare", key: "male_childcare_leave_rate", label: "男性育休取得率", note: "育児目的休暇を含まない" },
  { stat: "childcare-with-leave", key: "male_childcare_leave_rate_with_leave", label: "男性育休取得率", note: "育児目的休暇を含む" },
];

const sortedCompanies = baseCompanies
  .map((company) => {
     const disclosureId = disclosureIdForCompany(company);
     const companyMetrics = industryMetrics.filter(
       (metric) => metric.company_id === disclosureId,
     );
     const updatedAt = companyPageUpdatedAt(company.company_id);
     const addedAt = companyPageAddedAt(company.company_id);
     // 外資系の日本法人のように、採用主体と数値の開示主体が別法人の場合は
     // どの法人・どの範囲の数値かを行に明示する
     const discloser = disclosureCompanyFor(company);
     return {
       company,
       discloser,
       disclosureLabel: discloser
         ? discloser.country_code && discloser.country_code !== "JP"
           ? "グローバル連結"
           : "持株会社連結"
         : undefined,
       kanaRank: kanaRanks.get(company.company_id) ?? 0,
       addedAt: addedAt ? Date.parse(addedAt) : undefined,
       updatedAt: updatedAt ? formatUpdatedAt(updatedAt) : undefined,
       salary: comparableCell(latestMetric(companyMetrics, "average_annual_salary")),
       netCashFlow: comparableCell(latestMetric(companyMetrics, "net_cf")),
       // 重工各社のように営業利益を開示せず事業利益で開示する企業があるため、
       // 定義の違う値を同じ見出しへまとめず、見出しごと指標に合わせる
       profitMetric:
         latestMetric(companyMetrics, "operating_profit") ??
         latestMetric(companyMetrics, "business_profit"),
       operatingProfit: comparableCell(
         latestMetric(companyMetrics, "operating_profit") ??
           latestMetric(companyMetrics, "business_profit"),
       ),
       currentRatio: comparableCell(latestMetric(companyMetrics, "current_ratio")),
       humanCapital: Object.fromEntries(
         humanCapitalStats.map((definition) => [
           definition.stat,
           comparableCell(
             latestMetric(companyMetrics, definition.key, definition.scope),
           ),
         ]),
       ) as Record<string, ReturnType<typeof comparableCell>>,
     };
  })
  .sort((a, b) => {
    // 初期表示は並び替えコントロールの初期状態（五十音順）と揃える
    return a.kanaRank - b.kanaRank;
  });

const sortOptions: SortOption[] = [
  {
    value: "kana",
    label: "五十音順",
    asc: "五十音順（あ→ん）で並べています。",
    desc: "五十音順の逆（ん→あ）で並べています。",
    defaultOrder: "asc",
  },
  {
    value: "added",
    label: "追加日時",
    asc: "記事の追加日時が古い順で並べています。",
    desc: "記事の追加日時が新しい順で並べています。",
    defaultOrder: "desc",
  },
  {
    value: "salary",
    label: "平均給与",
    asc: "平均年間給与の低い順で並べています。",
    desc: "平均年間給与の高い順で並べています。",
    defaultOrder: "desc",
  },
  {
    value: "tenure",
    label: "平均勤続年数",
    asc: "平均勤続年数の短い順で並べています。",
    desc: "平均勤続年数の長い順で並べています。",
    defaultOrder: "desc",
  },
  {
    value: "age",
    label: "平均年齢",
    asc: "平均年齢の低い順で並べています。",
    desc: "平均年齢の高い順で並べています。",
    defaultOrder: "asc",
  },
  {
    value: "employees",
    label: "従業員数",
    asc: "従業員数の少ない順で並べています。",
    desc: "従業員数の多い順で並べています。",
    defaultOrder: "desc",
  },
  {
    value: "pay-gap",
    label: "男女の賃金の差異",
    asc: "男女の賃金の差異が大きい順（男性を100としたときの女性の水準が低い順）で並べています。",
    desc: "男女の賃金の差異が小さい順（男性を100としたときの女性の水準が高い順）で並べています。",
    defaultOrder: "desc",
  },
  {
    value: "female-managers",
    label: "女性管理職比率",
    asc: "女性管理職比率の低い順で並べています。",
    desc: "女性管理職比率の高い順で並べています。",
    defaultOrder: "desc",
  },
  {
    value: "childcare",
    label: "男性育休取得率（育児目的休暇を含まない）",
    asc: "男性育休取得率（育児目的休暇を含まない）の低い順で並べています。",
    desc: "男性育休取得率（育児目的休暇を含まない）の高い順で並べています。",
    defaultOrder: "desc",
  },
  {
    value: "childcare-with-leave",
    label: "男性育休取得率（育児目的休暇を含む）",
    asc: "男性育休取得率（育児目的休暇を含む）の低い順で並べています。",
    desc: "男性育休取得率（育児目的休暇を含む）の高い順で並べています。",
    defaultOrder: "desc",
  },
  {
    value: "netcf",
    label: "ネットCF",
    asc: "ネットCFの小さい順で並べています。",
    desc: "ネットCFの大きい順で並べています。",
    defaultOrder: "desc",
  },
  {
    value: "profit",
    label: "利益",
    asc: "各社が表示している営業利益・事業利益の小さい順で並べています。",
    desc: "各社が表示している営業利益・事業利益の大きい順で並べています。",
    defaultOrder: "desc",
  },
  {
    value: "ratio",
    label: "流動比率",
    asc: "流動比率の低い順で並べています。",
    desc: "流動比率の高い順で並べています。",
    defaultOrder: "desc",
  },
];
---

<BaseLayout
  title={industry.name}
  description={`${industry.name}の企業比較。給与・財務・キャッシュフロー・流動比率を年度別に確認できます。`}
>
  <section>
    <p class="breadcrumb">
      <a href="/">トップ</a><span>/</span><a href="/industries/">業界一覧</a><span>/</span>{industry.name}
    </p>
    <div class="industry-head">
      <div>
        <h1>{industry.name}</h1>
        {industry.description && <p class="lead">{industry.description}</p>}
      </div>
      <dl class="facts">
        <div><dt>掲載企業</dt><dd>{baseCompanies.length}社</dd></div>
        <div><dt>最新データ</dt><dd>{latestYear ? `${latestYear}年度` : "—"}</dd></div>
      </dl>
    </div>
    <p class="classification">
      <strong>分類の基準</strong>{industry.classification_basis}。企業は複数の業界に所属する場合があります。
    </p>
  </section>

  {IndustryArticle && (
    <section class="panel prose industry-prose">
      <IndustryArticle />
    </section>
  )}

  {industryMetrics.length > 0 ? <MetricExplorer
     companies={baseCompanies.map((company) => ({
       ...company,
       company_id: disclosureIdForCompany(company),
     }))}
     metrics={industryMetrics}
     explorerId={`explorer-${industry.industry_id}`}
     initialView="bar"
   /> : <section>
    <div class="section-head"><h2>指標を切り替えて比較する</h2></div>
     <div class="empty-inline">この業界の企業は非上場などにより財務指標の公表がなく、横断比較はできません。各社の採用情報や事業内容は企業詳細ページをご確認ください。</div>
   </section>}
  {currentRatios.length > 0 && <p class="section-note">流動比率は、同じ年度・対象範囲・会計基準の流動資産を流動負債で割って100を掛けたサイト算出値です。</p>}

  <section>
    <div class="section-head"><h2>この業界の企業</h2></div>
    <CompanySortControls
      controlsId={`industry-${industry.industry_id}`}
      options={sortOptions}
      initialSort="kana"
    />
    <div class="company-list" data-company-list={`industry-${industry.industry_id}`} data-sort="kana">
      {
        sortedCompanies.map(({ company, discloser, disclosureLabel, kanaRank, addedAt, updatedAt, salary, netCashFlow, profitMetric, operatingProfit, currentRatio, humanCapital }) => {
          return (
            <a
              class="linked-row"
              href={`/companies/${company.company_id}/`}
              data-sort-kana={kanaRank}
              data-sort-added={addedAt ?? ""}
              data-sort-salary={salary.sortValue}
              data-sort-netcf={netCashFlow.sortValue}
              data-sort-profit={operatingProfit.sortValue}
              data-sort-ratio={currentRatio.sortValue}
              {...Object.fromEntries(
                humanCapitalStats.map(({ stat }) => [
                  `data-sort-${stat}`,
                  humanCapital[stat].sortValue,
                ]),
              )}
            >
              <div>
                <h3>{company.display_name}</h3>
                <p class="legal-name">{company.legal_name}</p>
                {discloser && (
                  <p class="disclosure-note">
                    <em class="cohort-badge">{disclosureLabel}</em>
                    数値は{discloser.legal_name || discloser.display_name}の開示
                  </p>
                )}
                {updatedAt && <p class="row-updated">記事更新 {updatedAt}</p>}
              </div>
              <dl class="company-stats">
                <div data-stat="salary"><dt>平均年間給与</dt><dd>{salary.text}{salary.original && <small>{salary.original}</small>}</dd></div>
                <div data-stat="netcf"><dt>ネットCF</dt><dd>{netCashFlow.text}{netCashFlow.original && <small>{netCashFlow.original}</small>}</dd></div>
                <div data-stat="profit"><dt>{profitMetric ? metricLabels[profitMetric.metric_key] : "営業利益"}</dt><dd>{operatingProfit.text}{operatingProfit.original && <small>{operatingProfit.original}</small>}</dd></div>
                <div data-stat="ratio"><dt>流動比率</dt><dd>{currentRatio.text}{currentRatio.original && <small>{currentRatio.original}</small>}</dd></div>
                {humanCapitalStats.map(({ stat, label, note }) => (
                  <div data-stat={stat} data-stat-optional>
                    <dt>{label}</dt>
                    <dd>{humanCapital[stat].text}{note && <small>{note}</small>}</dd>
                  </div>
                ))}
              </dl>
            </a>
          );
        })
      }
    </div>
    <p class="section-note">
      平均勤続年数・平均年齢・従業員数・男女の賃金の差異・女性管理職比率・男性育休取得率は、その軸で並べているあいだだけ流動比率と入れ替えてカードに出しています。値を公表していない企業は、順序によらず末尾に並べています。
    </p>
  </section>
</BaseLayout>

<style>
  /* 働き方の指標は、その軸で並べているときだけ流動比率と入れ替えて出し、カードを4列に保つ */
  .company-stats > [data-stat-optional] { display: none; }
  .company-list:is(
    [data-sort="tenure"], [data-sort="age"], [data-sort="employees"],
    [data-sort="pay-gap"], [data-sort="female-managers"],
    [data-sort="childcare"], [data-sort="childcare-with-leave"]
  ) .company-stats > [data-stat="ratio"] { display: none; }
  .company-list[data-sort="tenure"] .company-stats > [data-stat="tenure"],
  .company-list[data-sort="age"] .company-stats > [data-stat="age"],
  .company-list[data-sort="employees"] .company-stats > [data-stat="employees"],
  .company-list[data-sort="pay-gap"] .company-stats > [data-stat="pay-gap"],
  .company-list[data-sort="female-managers"] .company-stats > [data-stat="female-managers"],
  .company-list[data-sort="childcare"] .company-stats > [data-stat="childcare"],
  .company-list[data-sort="childcare-with-leave"] .company-stats > [data-stat="childcare-with-leave"] {
    display: block;
  }

  /* モバイルは既存CSSで先頭の指標だけが残るため、並び替え中の指標を先頭へ寄せて表示する */
  @media (max-width: 720px) {
    .company-list:is(
      [data-sort="tenure"], [data-sort="age"], [data-sort="employees"],
      [data-sort="pay-gap"], [data-sort="female-managers"],
      [data-sort="childcare"], [data-sort="childcare-with-leave"]
    ) .company-stats > [data-stat="salary"] {
      display: none;
    }
    .company-list[data-sort="tenure"] .company-stats > [data-stat="tenure"],
    .company-list[data-sort="age"] .company-stats > [data-stat="age"],
    .company-list[data-sort="employees"] .company-stats > [data-stat="employees"],
    .company-list[data-sort="pay-gap"] .company-stats > [data-stat="pay-gap"],
    .company-list[data-sort="female-managers"] .company-stats > [data-stat="female-managers"],
    .company-list[data-sort="childcare"] .company-stats > [data-stat="childcare"],
    .company-list[data-sort="childcare-with-leave"] .company-stats > [data-stat="childcare-with-leave"] {
      display: flex;
      align-items: baseline;
      gap: 8px;
    }
    /* 1行に収めるため、算定範囲の補足は畳む。
       財務の軸で並べているあいだは原通貨の併記を残したいので、働き方の軸だけに絞る */
    .company-list:is(
      [data-sort="tenure"], [data-sort="age"], [data-sort="employees"],
      [data-sort="pay-gap"], [data-sort="female-managers"],
      [data-sort="childcare"], [data-sort="childcare-with-leave"]
    ) .company-stats dd small {
      display: none;
    }
  }
</style>
