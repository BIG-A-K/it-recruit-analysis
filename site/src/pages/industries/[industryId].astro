---
import type { GetStaticPaths, MDXInstance } from "astro";
import CompanySortControls from "../../components/CompanySortControls.astro";
import type { SortOption } from "../../components/CompanySortControls.astro";
import MetricExplorer from "../../components/MetricExplorer.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  companiesForIndustry,
  disclosureCompanyFor,
  disclosureIdForCompany,
  industries,
  metricsForCompanies,
} from "../../lib/data";
import type { Metric } from "../../lib/data";
import { companyPageUpdatedAt, formatUpdatedAt } from "../../lib/company-pages";
import { formatValue, latestMetric, metricLabels } from "../../lib/format";
import { withJpyEquivalent } from "../../lib/fx";
import type { MetricWithFx } from "../../lib/fx";

export const getStaticPaths = (() =>
  industries.map((industry) => ({
    params: { industryId: industry.industry_id },
    props: { industry },
  }))) satisfies GetStaticPaths;

// 手書きの業界解説。`_articles/<industry_id>.mdx` を置いた業界だけ本文が出る。
// `_` で始まるディレクトリは Astro がページとして扱わないため、ここから
// 読み込んで業界ページの一部として描画する。
const articleModules = import.meta.glob<MDXInstance<Record<string, unknown>>>(
  "./_articles/*.mdx",
  { eager: true },
);

const { industry } = Astro.props;
const IndustryArticle =
  articleModules[`./_articles/${industry.industry_id}.mdx`]?.Content;
const baseCompanies = companiesForIndustry(industry.industry_id);
const relatedMetrics = metricsForCompanies(
  baseCompanies.map((company) => disclosureIdForCompany(company)),
);
const metricIdentity = (metric: Metric) =>
  [
    metric.fiscal_year,
    metric.period_end,
    metric.scope,
    metric.accounting_standard,
  ].join("\u0000");
const currentRatios = baseCompanies.flatMap((company) => {
  const disclosureId = disclosureIdForCompany(company);
  const companyMetrics = relatedMetrics.filter(
    (metric) => metric.company_id === disclosureId,
  );
  const assets = new Map(
    companyMetrics
      .filter((metric) => metric.metric_key === "current_assets")
      .map((metric) => [metricIdentity(metric), metric]),
  );
  const liabilities = new Map(
    companyMetrics
      .filter((metric) => metric.metric_key === "current_liabilities")
      .map((metric) => [metricIdentity(metric), metric]),
  );

  return [...assets.entries()].flatMap(([identity, asset]) => {
    const liability = liabilities.get(identity);
    if (!liability || Number(liability.value) === 0) return [];

    return [{
      ...asset,
      metric_key: "current_ratio",
      value: String(
        (Number(asset.value) / Number(liability.value) * 100).toFixed(6),
      ),
      unit: "percent",
      note: "流動資産 / 流動負債 × 100（サイト算出値）",
    }];
  });
});
const industryMetrics = withJpyEquivalent([...relatedMetrics, ...currentRatios]);
const metricYears = industryMetrics.map((metric) =>
  Number(metric.fiscal_year),
);

// 一覧は通貨の違う企業が同じ列に並ぶため、表示と並び替えを円換算値に揃える。
// 換算した場合は公表値をそのまま読めるよう原通貨の額を併記する。
const comparableCell = (metric: MetricWithFx | undefined) => {
  if (!metric) return { text: "—", original: undefined, sortValue: "" };

  const reported = formatValue(
    Number(metric.value),
    metric.unit,
    metric.metric_key,
  );
  // 為替相場を用意していない年度は換算せず、公表値のまま並び替えの対象から外す
  if (metric.comparable_value === "") {
    return { text: reported, original: undefined, sortValue: "" };
  }

  const converted = metric.comparable_unit !== metric.unit;
  return {
    text: converted
      ? formatValue(
          Number(metric.comparable_value),
          metric.comparable_unit,
          metric.metric_key,
        )
      : reported,
    original: converted ? reported : undefined,
    sortValue: metric.comparable_value,
  };
};
const latestYear = metricYears.length ? Math.max(...metricYears) : undefined;

const collator = new Intl.Collator("ja");
const kanaRanks = new Map(
  [...baseCompanies]
    .sort((a, b) => collator.compare(a.name_kana, b.name_kana))
    .map((company, index) => [company.company_id, index]),
);

const sortedCompanies = baseCompanies
  .map((company) => {
     const disclosureId = disclosureIdForCompany(company);
     const companyMetrics = industryMetrics.filter(
       (metric) => metric.company_id === disclosureId,
     );
     const updatedAt = companyPageUpdatedAt(company.company_id);
     // 外資系の日本法人のように、採用主体と数値の開示主体が別法人の場合は
     // どの法人・どの範囲の数値かを行に明示する
     const discloser = disclosureCompanyFor(company);
     return {
       company,
       discloser,
       disclosureLabel: discloser
         ? discloser.country_code && discloser.country_code !== "JP"
           ? "グローバル連結"
           : "持株会社連結"
         : undefined,
       kanaRank: kanaRanks.get(company.company_id) ?? 0,
       updatedAt: updatedAt ? formatUpdatedAt(updatedAt) : undefined,
       salary: comparableCell(latestMetric(companyMetrics, "average_annual_salary")),
       netCashFlow: comparableCell(latestMetric(companyMetrics, "net_cf")),
       // 重工各社のように営業利益を開示せず事業利益で開示する企業があるため、
       // 定義の違う値を同じ見出しへまとめず、見出しごと指標に合わせる
       profitMetric:
         latestMetric(companyMetrics, "operating_profit") ??
         latestMetric(companyMetrics, "business_profit"),
       operatingProfit: comparableCell(
         latestMetric(companyMetrics, "operating_profit") ??
           latestMetric(companyMetrics, "business_profit"),
       ),
       currentRatio: comparableCell(latestMetric(companyMetrics, "current_ratio")),
     };
  })
  .sort((a, b) => {
    // 初期表示は並び替えコントロールの初期状態（五十音順）と揃える
    return a.kanaRank - b.kanaRank;
  });

const sortOptions: SortOption[] = [
  {
    value: "kana",
    label: "五十音順",
    asc: "五十音順（あ→ん）で並べています。",
    desc: "五十音順の逆（ん→あ）で並べています。",
    defaultOrder: "asc",
  },
  {
    value: "salary",
    label: "平均給与",
    asc: "平均年間給与の低い順で並べています。",
    desc: "平均年間給与の高い順で並べています。",
    defaultOrder: "desc",
  },
  {
    value: "netcf",
    label: "ネットCF",
    asc: "ネットCFの小さい順で並べています。",
    desc: "ネットCFの大きい順で並べています。",
    defaultOrder: "desc",
  },
  {
    value: "profit",
    label: "利益",
    asc: "各社が表示している営業利益・事業利益の小さい順で並べています。",
    desc: "各社が表示している営業利益・事業利益の大きい順で並べています。",
    defaultOrder: "desc",
  },
  {
    value: "ratio",
    label: "流動比率",
    asc: "流動比率の低い順で並べています。",
    desc: "流動比率の高い順で並べています。",
    defaultOrder: "desc",
  },
];
---

<BaseLayout
  title={industry.name}
  description={`${industry.name}の企業比較。給与・財務・キャッシュフロー・流動比率を年度別に確認できます。`}
>
  <section>
    <p class="breadcrumb">
      <a href="/">トップ</a><span>/</span><a href="/industries/">業界一覧</a><span>/</span>{industry.name}
    </p>
    <div class="industry-head">
      <div>
        <h1>{industry.name}</h1>
        {industry.description && <p class="lead">{industry.description}</p>}
      </div>
      <dl class="facts">
        <div><dt>掲載企業</dt><dd>{baseCompanies.length}社</dd></div>
        <div><dt>最新データ</dt><dd>{latestYear ? `${latestYear}年度` : "—"}</dd></div>
      </dl>
    </div>
    <p class="classification">
      <strong>分類の基準</strong>{industry.classification_basis}。企業は複数の業界に所属する場合があります。
    </p>
  </section>

  {IndustryArticle && (
    <section class="panel prose industry-prose">
      <IndustryArticle />
    </section>
  )}

  {industryMetrics.length > 0 ? <MetricExplorer
     companies={baseCompanies.map((company) => ({
       ...company,
       company_id: disclosureIdForCompany(company),
     }))}
     metrics={industryMetrics}
     explorerId={`explorer-${industry.industry_id}`}
     initialView="bar"
   /> : <section>
    <div class="section-head"><h2>指標を切り替えて比較する</h2></div>
     <div class="empty-inline">この業界の企業は非上場などにより財務指標の公表がなく、横断比較はできません。各社の採用情報や事業内容は企業詳細ページをご確認ください。</div>
   </section>}
  {currentRatios.length > 0 && <p class="section-note">流動比率は、同じ年度・対象範囲・会計基準の流動資産を流動負債で割って100を掛けたサイト算出値です。</p>}

  <section>
    <div class="section-head"><h2>この業界の企業</h2></div>
    <CompanySortControls
      controlsId={`industry-${industry.industry_id}`}
      options={sortOptions}
      initialSort="kana"
    />
    <div class="company-list" data-company-list={`industry-${industry.industry_id}`}>
      {
        sortedCompanies.map(({ company, discloser, disclosureLabel, kanaRank, updatedAt, salary, netCashFlow, profitMetric, operatingProfit, currentRatio }) => {
          return (
            <a
              class="linked-row"
              href={`/companies/${company.company_id}/`}
              data-sort-kana={kanaRank}
              data-sort-salary={salary.sortValue}
              data-sort-netcf={netCashFlow.sortValue}
              data-sort-profit={operatingProfit.sortValue}
              data-sort-ratio={currentRatio.sortValue}
            >
              <div>
                <h3>{company.display_name}</h3>
                <p class="legal-name">{company.legal_name}</p>
                {discloser && (
                  <p class="disclosure-note">
                    <em class="cohort-badge">{disclosureLabel}</em>
                    数値は{discloser.legal_name || discloser.display_name}の開示
                  </p>
                )}
                {updatedAt && <p class="row-updated">記事更新 {updatedAt}</p>}
              </div>
              <dl class="company-stats">
                <div><dt>平均年間給与</dt><dd>{salary.text}{salary.original && <small>{salary.original}</small>}</dd></div>
                <div><dt>ネットCF</dt><dd>{netCashFlow.text}{netCashFlow.original && <small>{netCashFlow.original}</small>}</dd></div>
                <div><dt>{profitMetric ? metricLabels[profitMetric.metric_key] : "営業利益"}</dt><dd>{operatingProfit.text}{operatingProfit.original && <small>{operatingProfit.original}</small>}</dd></div>
                <div><dt>流動比率</dt><dd>{currentRatio.text}{currentRatio.original && <small>{currentRatio.original}</small>}</dd></div>
              </dl>
            </a>
          );
        })
      }
    </div>
  </section>
</BaseLayout>
